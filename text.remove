  +++++++++++++
  
  
  CREATE TABLE IF NOT EXISTS `dq_metadata.scd2_config`
(
  table_name     STRING,           -- fully-qualified:  project.dataset.table
  key_cols       ARRAY<STRING>,    -- 1-or-more column names that make the key
  from_col       STRING,           -- EFFECTIVE_FROM column
  to_col         STRING            -- EFFECTIVE_TO column
);

INSERT INTO `dq_metadata.scd2_config` VALUES
  ('src_bi.FMO_APPLICATION', ['APPLICATION_ID'], 'EFFECTIVE_FROM_DATE', 'EFFECTIVE_TO_DATE'),
  ('src_bi.FMO_CUSTOMER'   , ['CUSTOMER_ID']   , 'EFFECTIVE_FROM_DATE', 'EFFECTIVE_TO_DATE'),
  ('src_bi.FMO_ASSET'      , ['ASSET_ID']      , 'FROM_TS'           , 'TO_TS');   -- example with different col names



CREATE OR REPLACE PROCEDURE dq_metadata.validate_scd2_generic()
BEGIN
  DECLARE cfg RECORD;
  DECLARE qry STRING;

  FOR cfg IN (
    SELECT *
    FROM `dq_metadata.scd2_config`
  ) DO

    -- Build the comma-separated key for PARTITION BY / ORDER BY
    DECLARE key_list   STRING  DEFAULT ARRAY_TO_STRING(cfg.key_cols, ', ');
    DECLARE key_select STRING  DEFAULT ARRAY_TO_STRING(
                                  (SELECT ARRAY_AGG(FORMAT('%s', col) ORDER BY col)
                                   FROM UNNEST(cfg.key_cols) col), ', ');
    DECLARE key_join   STRING  DEFAULT ARRAY_TO_STRING(
                                  (SELECT ARRAY_AGG(FORMAT('t.%1$s = s.%1$s', col) ORDER BY col)
                                   FROM UNNEST(cfg.key_cols) col), ' AND ');

    SET qry = FORMAT("""
    --------------------------------------------------
    -- %s  (auto-generated SCD-2 validation)
    --------------------------------------------------
    WITH ordered AS (
      SELECT
        %s,
        %s   AS from_dt,
        %s   AS to_dt,

        LEAD(%s) OVER (PARTITION BY %s ORDER BY %s DESC)  AS next_from_dt,
        ROW_NUMBER()  OVER (PARTITION BY %s ORDER BY %s DESC)  AS rn_latest,
        COUNTIF(%s = DATETIME '9999-12-31 23:59:59')
            OVER (PARTITION BY %s)                        AS open_row_cnt
      FROM `%s`
    ),

    checks AS (
      SELECT
        %s,
        from_dt,
        to_dt,
        next_from_dt,

        ARRAY_CONCAT(
          -- duplicate open rows
          CASE WHEN open_row_cnt > 1 AND to_dt = DATETIME '9999-12-31 23:59:59'
               THEN ['BAD_ACTIVE_DUPLICATE'] ELSE [] END,

          -- overlaps
          CASE WHEN rn_latest > 1 AND to_dt >= next_from_dt
               THEN ['OVERLAP']              ELSE [] END,

          -- zero-day (comment out if allowed)
          CASE WHEN from_dt = to_dt
               THEN ['ZERO_DAY']             ELSE [] END
        ) AS issues
      FROM ordered
    )

    -- write issues into a standard DQ table
    INSERT INTO `dq_metadata.DQ_SCD2_ISSUES`
    SELECT
      CURRENT_TIMESTAMP()         AS run_ts,
      '%s'                        AS table_name,
      TO_JSON_STRING(STRUCT(%s))  AS key_json,         -- keeps multi-col keys
      from_dt, to_dt,
      issues
    FROM checks
    WHERE ARRAY_LENGTH(issues) > 0;
    """,
    --------------------------------------------------
    cfg.table_name,          -- banner
    key_select,              -- SELECT key…
    cfg.from_col, cfg.to_col,
    cfg.from_col, key_list,  -- LEAD / PARTITION
    cfg.from_col,
    key_list, cfg.from_col,
    cfg.to_col, key_list,
    cfg.table_name,
    key_select,              -- SELECT again inside checks
    cfg.table_name,
    key_select               -- key_json
    );

    EXECUTE IMMEDIATE qry;

  END FOR;
END;



CALL dq_metadata.validate_scd2_generic();


SELECT *
FROM dq_metadata.DQ_SCD2_ISSUES
ORDER BY run_ts DESC, table_name;




<mxfile host="app.diagrams.net" modified="2026-08-25T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device">
  <diagram id="payroll-crows-foot" name="Payroll Conceptual Model - Crow's Foot">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Payroll Domain — Conceptual Data Model" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="850" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Business concepts, definitions and relationships using Crow's Foot notation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#5B6472;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="850" height="30" as="geometry"/></mxCell>

        <mxCell id="worker" value="&lt;div style=&quot;background:#DCE8F5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;WORKER&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents a person who has a working relationship with an organisation. Workforce owns the worker identity and core details; Payroll references the worker.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#5B79A7;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="460" height="190" as="geometry"/></mxCell>

        <mxCell id="employment" value="&lt;div style=&quot;background:#F3E8B5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;EMPLOYMENT&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents the contractual working relationship between a WORKER and an employing organisation, including effective dates and status. One Worker may have multiple Employments.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#B99A37;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="650" y="120" width="500" height="190" as="geometry"/></mxCell>

        <mxCell id="enrolment" value="&lt;div style=&quot;background:#E7DCF3;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL ENROLMENT&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Connects an eligible EMPLOYMENT to a payroll arrangement. It determines when and how that Employment is included in payroll processing.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#856AA9;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="1300" y="120" width="460" height="190" as="geometry"/></mxCell>

        <mxCell id="input" value="&lt;div style=&quot;background:#DCEFCF;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL INPUT&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents an amount, time value, instruction or event used to calculate pay, such as salary, overtime, allowance, absence, tax, pension or retrospective adjustment.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#6B9B52;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="460" height="230" as="geometry"/></mxCell>

        <mxCell id="run" value="&lt;div style=&quot;background:#DCE8F5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL RUN&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents an execution of payroll calculation for a defined PAYROLL PERIOD. It applies payroll rules and inputs to eligible Payroll Enrolments and records status, exceptions and approval.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#5B79A7;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="650" y="430" width="500" height="230" as="geometry"/></mxCell>

        <mxCell id="period" value="&lt;div style=&quot;background:#F3E8B5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL PERIOD&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Defines the time interval for which pay is calculated and reported, including period start, period end, cut-off and payment date.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#B99A37;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="1300" y="430" width="460" height="230" as="geometry"/></mxCell>

        <mxCell id="result" value="&lt;div style=&quot;background:#E7DCF3;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL RESULT&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents the calculated payroll outcome for a Payroll Enrolment and Payroll Run, including earnings, deductions, employer contributions, gross pay, balances and net pay.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#856AA9;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="650" y="790" width="500" height="200" as="geometry"/></mxCell>

        <mxCell id="payment" value="&lt;div style=&quot;background:#DCEFCF;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYMENT&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents settlement of approved net pay, including payment instruction, amount, method, date and status. Failed or reversed Payments remain traceable.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#6B9B52;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="480" height="210" as="geometry"/></mxCell>

        <mxCell id="cost" value="&lt;div style=&quot;background:#DCE8F5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;COST ALLOCATION&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents distribution of payroll expenditure to Finance structures such as Cost Centre, Organisation Unit or Programme for accounting and reconciliation.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#5B79A7;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="660" y="1090" width="480" height="210" as="geometry"/></mxCell>

        <mxCell id="reporting" value="&lt;div style=&quot;background:#F3E8B5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL REPORTING&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents outputs derived from approved Payroll Results, including payslips, reconciliation and statutory submissions to authorised external organisations.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#B99A37;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="1280" y="1090" width="480" height="210" as="geometry"/></mxCell>

        <!-- Crow's Foot edges: ERone, ERzeroToMany and ERoneToMany -->
        <mxCell id="e1" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERoneToMany;endFill=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="worker" target="employment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="employment" target="enrolment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="is processed by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERzeroToMany;startFill=0;endArrow=ERzeroToMany;endFill=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="enrolment" target="run"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1530" y="380"/><mxPoint x="1080" y="380"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="is used by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERzeroToMany;startFill=0;endArrow=ERzeroToMany;endFill=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="input" target="run"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="schedules" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="period" target="run"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="produces" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERoneToMany;endFill=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="run" target="result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="receives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;exitX=0.3;exitY=1;entryX=0.98;entryY=0;" edge="1" parent="1" source="enrolment" target="result"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="350"/><mxPoint x="1200" y="350"/><mxPoint x="1200" y="750"/></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="authorises" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="result" target="payment"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="1040"/><mxPoint x="280" y="1040"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="produces" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="result" target="cost"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="supports" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERoneToMany;startFill=0;endArrow=ERzeroToMany;endFill=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="result" target="reporting"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="1040"/><mxPoint x="1520" y="1040"/></Array></mxGeometry></mxCell>

        <mxCell id="legend" value="Crow's Foot legend:  | = one     O| = zero or one     |&lt; = one or many     O&lt; = zero or many" style="text;html=1;strokeColor=#CBD5E1;fillColor=#F8FAFC;rounded=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="470" y="1330" width="860" height="38" as="geometry"/></mxCell>
        <mxCell id="scope" value="Scope note: Worker and Employment are owned by Workforce; Payroll references them. Cost structures are owned by Finance." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#5B6472;" vertex="1" parent="1"><mxGeometry x="60" y="1380" width="1300" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

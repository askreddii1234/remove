<mxfile host="app.diagrams.net" modified="2026-08-25T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device">
  <diagram id="payroll-logical-definitions" name="Payroll Logical Data Model">
    <mxGraphModel dx="2800" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Payroll Domain — Logical Data Model" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="900" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Entity definitions and Crow's Foot relationships · Attributes and implementation details intentionally excluded" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#5B6472;" vertex="1" parent="1"><mxGeometry x="50" y="62" width="1100" height="30" as="geometry"/></mxCell>

        <!-- Row 1: Workforce and payroll framework -->
        <mxCell id="worker" value="&lt;div style=&quot;background:#DCE8F5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;WORKER&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents a person who has a working relationship with an organisation and may be eligible for payroll processing.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#5B79A7;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="460" height="175" as="geometry"/></mxCell>

        <mxCell id="employment" value="&lt;div style=&quot;background:#F3E8B5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;EMPLOYMENT&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents the contractual working relationship between a Worker and an employing organisation, including its period of validity and status.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#B99A37;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="460" height="175" as="geometry"/></mxCell>

        <mxCell id="enrolment" value="&lt;div style=&quot;background:#E7DCF3;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL ENROLMENT&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents the registration of an eligible Employment in a Payroll and defines when that Employment participates in payroll processing.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#856AA9;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="460" height="175" as="geometry"/></mxCell>

        <mxCell id="payroll" value="&lt;div style=&quot;background:#DCE8F5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents a configured payroll arrangement that groups enrolled Employments under a common frequency, currency and processing framework.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#5B79A7;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="1660" y="120" width="460" height="175" as="geometry"/></mxCell>

        <mxCell id="period" value="&lt;div style=&quot;background:#F3E8B5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL PERIOD&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents a defined time interval for which a Payroll is calculated, paid, reported and subsequently closed.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#B99A37;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="2200" y="120" width="460" height="175" as="geometry"/></mxCell>

        <!-- Row 2: Inputs and processing -->
        <mxCell id="element" value="&lt;div style=&quot;background:#E7DCF3;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL ELEMENT&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents a controlled classification of an earning, deduction or employer contribution used consistently in payroll input and result calculation.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#856AA9;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="460" height="190" as="geometry"/></mxCell>

        <mxCell id="input" value="&lt;div style=&quot;background:#DCEFCF;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL INPUT&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents an approved amount, quantity, rate, instruction or event supplied for the calculation of pay for a Payroll Enrolment.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#6B9B52;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="580" y="450" width="460" height="190" as="geometry"/></mxCell>

        <mxCell id="run" value="&lt;div style=&quot;background:#DCE8F5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL RUN&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents an execution of payroll calculation for a Payroll Period, processing eligible Enrolments and producing Payroll Results.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#5B79A7;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="1120" y="450" width="460" height="190" as="geometry"/></mxCell>

        <!-- Row 3: Results and statutory association -->
        <mxCell id="result-line" value="&lt;div style=&quot;background:#E7DCF3;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL RESULT LINE&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents an individual calculated earning, deduction or employer contribution within a Payroll Result, classified by Payroll Element.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#856AA9;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="580" y="780" width="460" height="190" as="geometry"/></mxCell>

        <mxCell id="result" value="&lt;div style=&quot;background:#E7DCF3;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYROLL RESULT&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents the worker-level calculated outcome produced by a Payroll Run for a Payroll Enrolment, summarising earnings, deductions and net pay.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#856AA9;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="1120" y="780" width="460" height="190" as="geometry"/></mxCell>

        <mxCell id="submission-result" value="&lt;div style=&quot;background:#F3E8B5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;SUBMISSION RESULT&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents the association between a Payroll Result and a Statutory Submission, identifying which calculated result was reported.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#B99A37;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="1660" y="780" width="460" height="190" as="geometry"/></mxCell>

        <mxCell id="submission" value="&lt;div style=&quot;background:#F3E8B5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;STATUTORY SUBMISSION&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents payroll information formally reported for a Payroll Period to a tax, pension or other authorised external body.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#B99A37;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="2200" y="780" width="460" height="190" as="geometry"/></mxCell>

        <!-- Row 4: Payments, costing and employee output -->
        <mxCell id="cost" value="&lt;div style=&quot;background:#DCE8F5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;COST ALLOCATION&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents the distribution of a Payroll Result Line amount to Finance structures for accounting, reporting and reconciliation.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#5B79A7;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="580" y="1110" width="460" height="185" as="geometry"/></mxCell>

        <mxCell id="payment-instruction" value="&lt;div style=&quot;background:#DCEFCF;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYMENT INSTRUCTION&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents an approved instruction to settle the net-pay amount associated with a Payroll Result using a specified payment method.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#6B9B52;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="1120" y="1110" width="460" height="185" as="geometry"/></mxCell>

        <mxCell id="payment-transaction" value="&lt;div style=&quot;background:#DCEFCF;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYMENT TRANSACTION&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents an attempt to execute a Payment Instruction, including successful settlement, rejection, retry or reversal.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#6B9B52;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="1660" y="1110" width="460" height="185" as="geometry"/></mxCell>

        <mxCell id="payslip" value="&lt;div style=&quot;background:#F3E8B5;padding:10px;text-align:center;font-weight:bold;font-size:17px&quot;&gt;PAYSLIP&lt;/div&gt;&lt;div style=&quot;padding:13px;text-align:left;font-size:14px;line-height:1.45&quot;&gt;Represents the worker-facing statement generated from an approved Payroll Result for a Payroll Period.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#B99A37;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontColor=#303846;" vertex="1" parent="1"><mxGeometry x="2200" y="1110" width="460" height="185" as="geometry"/></mxCell>

        <!-- Crow's Foot relationships -->
        <mxCell id="e1" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="worker" target="employment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="employment" target="enrolment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="contains" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="payroll" target="enrolment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="contains" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERoneToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="payroll" target="period"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="schedules" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="period" target="run"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2430" y="380"/><mxPoint x="1620" y="380"/><mxPoint x="1620" y="545"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="receives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;exitX=0.25;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="enrolment" target="input"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="380"/><mxPoint x="1080" y="380"/><mxPoint x="1080" y="545"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="classifies" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="element" target="input"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="produces" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERoneToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="run" target="result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="receives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;exitX=0.75;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="enrolment" target="result"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="380"/><mxPoint x="1600" y="380"/><mxPoint x="1600" y="730"/><mxPoint x="1550" y="730"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="contains" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERoneToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="result" target="result-line"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="classifies" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="element" target="result-line"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="700"/><mxPoint x="540" y="700"/><mxPoint x="540" y="875"/></Array></mxGeometry></mxCell>
        <mxCell id="e12" value="is allocated by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="result-line" target="cost"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="authorises" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="result" target="payment-instruction"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="is executed by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="payment-instruction" target="payment-transaction"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="generates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToOne;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="result" target="payslip"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="1030"/><mxPoint x="2160" y="1030"/><mxPoint x="2160" y="1200"/></Array></mxGeometry></mxCell>
        <mxCell id="e16" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="period" target="submission"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2700" y="207"/><mxPoint x="2700" y="875"/></Array></mxGeometry></mxCell>
        <mxCell id="e17" value="contains" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERoneToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="submission" target="submission-result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="is reported through" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4B5563;strokeWidth=2;startArrow=ERone;endArrow=ERzeroToMany;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="result" target="submission-result"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="legend" value="Crow's Foot legend:  | = exactly one     O| = zero or one     |&lt; = one or many     O&lt; = zero or many" style="text;html=1;strokeColor=#CBD5E1;fillColor=#F8FAFC;rounded=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="860" y="1400" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="note" value="Model scope: logical business entities and relationships only. Attributes, identifiers, source-system fields and physical implementation are intentionally excluded." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#5B6472;" vertex="1" parent="1"><mxGeometry x="650" y="1460" width="1400" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

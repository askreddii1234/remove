  <diagram id="baseline" name="1 - Current Enterprise Alignment">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title1" value="Payroll Alignment to the Existing Enterprise Conceptual Data Model" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=26;fontStyle=1;fontColor=#253041;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle1" value="Current-state alignment — approved concepts reused without changing the enterprise baseline" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=14;fontColor=#596273;" vertex="1" parent="1"><mxGeometry x="60" y="68" width="1400" height="28" as="geometry"/></mxCell>

        <mxCell id="party_h" value="PARTY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE8F5;strokeColor=#5B79A7;strokeWidth=2;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#253041;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="170" width="310" height="42" as="geometry"/></mxCell>
        <mxCell id="party" value="A person or organisation of interest to the enterprise.&#xa;&#xa;Payroll examples: Worker, employing organisation, payroll provider, tax authority and pension provider." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B79A7;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#303846;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="90" y="212" width="310" height="130" as="geometry"/></mxCell>

        <mxCell id="episode_h" value="EPISODE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E8B5;strokeColor=#B99A37;strokeWidth=2;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#253041;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="645" y="170" width="310" height="42" as="geometry"/></mxCell>
        <mxCell id="episode" value="A bounded course of related activity or involvement occurring over time.&#xa;&#xa;Payroll alignment: an employment or payroll-participation episode. This mapping requires stakeholder validation because an agreement is not identical to an episode." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B99A37;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#303846;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="645" y="212" width="310" height="145" as="geometry"/></mxCell>

        <mxCell id="event_h" value="EVENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7DCF3;strokeColor=#856AA9;strokeWidth=2;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#253041;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="170" width="310" height="42" as="geometry"/></mxCell>
        <mxCell id="event" value="An occurrence of business significance that is recorded by the enterprise.&#xa;&#xa;Payroll examples: joiner, salary change, absence, payroll run, payment execution and statutory submission." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#856AA9;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#303846;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="212" width="310" height="130" as="geometry"/></mxCell>

        <mxCell id="location_h" value="LOCATION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFCF;strokeColor=#6B9B52;strokeWidth=2;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#253041;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="520" width="310" height="42" as="geometry"/></mxCell>
        <mxCell id="location" value="A physical, postal, organisational or jurisdictional place relevant to an enterprise activity.&#xa;&#xa;Payroll examples: work location, employing location, payment jurisdiction and tax jurisdiction." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B9B52;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#303846;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="360" y="562" width="310" height="130" as="geometry"/></mxCell>


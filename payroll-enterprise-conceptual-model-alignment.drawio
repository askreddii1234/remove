        <mxCell id="note1" value="Architecture note: Party, Location, Episode and Event are reused from the current enterprise model. Laboratory Scientific Asset is explicitly not applicable. Cardinalities and the use of Episode for employment/payroll participation are proposed pending business and enterprise-modelling validation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C7A84E;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#4A4030;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="300" y="742" width="1210" height="70" as="geometry"/></mxCell>
